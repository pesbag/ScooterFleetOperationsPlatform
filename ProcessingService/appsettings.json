{
  "Kafka": {
    "BootstrapService": "localhost:9092",
    "GroupId": "stations_1",
    "Topics": {
      "StationInformation": "bike.station-information",
      "StationStatus": "bike.station-status",
      "VehicleTypes": "bike.vehicle-types"
    },
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "stations_1",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false
    }
  },
  "StationInformation": "LyftStationClient",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=stationDb;User=root;"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "StationsStatus"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
