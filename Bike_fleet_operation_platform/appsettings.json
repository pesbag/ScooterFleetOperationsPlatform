{
  "Kafka": {
    "BootstrapServices": "localhost:9092",
    "GroupId": "stations_1",
    "Topics": {
      "StationInformation": "bike.station-information",
      "StationStatus": "bike.station-status",
      "VehicleTypes": "bike.vehicle-types"
    }
  },
  "StationInformation": "LyftStationClient",
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=stationDb;User=root;"
  },
  "Polling": {
    "StationInformationIntervalSeconds": "3600",
    "StationStatusIntervalSeconds": "60",
    "VehicleTypesIntervalSeconds": "3600"
  },
  "DataSource": {
    "Mode": "Demo",
    "BaseUrl": "https://gbfs.lyft.com/gbfs/2.3/bkn/en/"
  }
}
