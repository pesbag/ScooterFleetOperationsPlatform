@model IEnumerable<JsonElement>
<div class="table-scroll"><table>
<thead><tr><th>Station</th><th>Availability</th><th>Utilization</th><th>Risk</th><th>Net trend / hour</th><th>Status / data</th><th></th></tr></thead>
<tbody>
@foreach (var row in Model)
{
    var station = row.GetProperty("station");
    <tr><td><a class="station-name" asp-action="Station" asp-route-id="@station.Text("id")">@station.StationName()</a><small>@station.Text("id")</small></td>
    <td><strong>@(row.Text("stale") == "True" ? "Unknown" : station.Text("count"))</strong> <span class="muted">/ @station.CapacityText() bikes</span></td>
    <td>@if (row.Text("stale") != "True" && row.Text("utilization") != "—") { <meter min="0" max="100" value="@row.Text("utilization")">@row.Text("utilization")%</meter><small>@row.Text("utilization")% occupied</small> } else { <span>—</span> }</td>
    <td><strong>@row.Text("riskScore")</strong><small>@ViewText.Label(row.Text("riskLevel")) risk</small></td>
    <td>@row.Text("ratePerHour")<small>@(row.Text("stale") == "True" ? "Not calculated" : "bikes / hour")</small></td>
    <td><span class="badge @row.Text("status").ToLowerInvariant()">@ViewText.Label(row.Text("status"))</span><small>@row.DataLabel()</small><small>Operation: @row.Text("operationalStatus") · @row.Text("openIssueCount") open issues</small><small>Reported: @station.Time("reportedAt")</small><small>Received: @station.Time("receivedAt")</small></td>
    <td><a asp-action="Station" asp-route-id="@station.Text("id")" aria-label="View @station.StationName()">↗</a></td></tr>
}
</tbody></table></div>
@if (!Model.Any()) { <div class="empty">No stations match this view. Data may still be arriving; refresh shortly.</div> }
