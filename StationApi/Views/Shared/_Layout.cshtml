@{ var current = ViewBag.CurrentUser is JsonElement element ? element : default; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Scooter Fleet</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (current.ValueKind == JsonValueKind.Object)
{
    <aside class="sidebar">
        <a class="brand" asp-action="Dashboard" asp-controller="Workspace"><span class="brand-icon">S</span><span>SCOOTER<span class="brand-sub">FLEET OPERATIONS</span></span></a>
        <div class="nav-caption">WORKSPACE</div>
        <nav aria-label="Main navigation">
            @foreach (var item in new[] { ("Dashboard", "Overview", "◫"), ("Stations", "Stations", "⊙"), ("Alerts", "Alerts", "!"), ("Recommendations", "Rebalancing", "⇄") })
            {
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == item.Item1 ? "selected" : "")" asp-controller="Workspace" asp-action="@item.Item1"><span>@item.Item3</span>@item.Item2</a>
            }
            @if (current.Text("role") == "ADMIN") { <a asp-controller="Workspace" asp-action="Users"><span>♙</span>Team management</a> }
        </nav>
        <div class="sidebar-note"><span class="live-dot"></span> Smarter moves.<br /><small>A balanced fleet starts here.</small></div>
        <a class="account" asp-controller="Workspace" asp-action="Profile"><span class="avatar">@current.Text("name").FirstOrDefault()</span><span>@current.Text("name")<small>@current.Text("role")</small></span></a>
        <form asp-action="Logout" asp-controller="Workspace" method="post"><button class="signout" type="submit">Sign out ↗</button></form>
    </aside>
}
<main class="@(current.ValueKind == JsonValueKind.Object ? "workspace" : "public")">
    @if (TempData["Success"] is string message) { <div class="notice success" role="status">@message</div> }
    @RenderBody()
</main>
</body>
</html>
