@model IEnumerable<JsonElement>
@foreach (var item in Model)
{
    <article id="task-@item.Text("id")" class="recommendation @(ViewBag.UpdatedId?.ToString() == item.Text("id") ? "updated-task" : "")">
        <div class="card-top"><span class="badge @item.Text("priority").ToLowerInvariant()">@ViewText.Label(item.Text("priority")) priority</span><span>#@item.Text("id") · <strong class="task-status">@ViewText.Label(item.Text("status"))</strong></span></div>
        <h3>Move @item.Text("quantity") bikes</h3>
        <div class="route"><div><strong>@item.StationName("sourceStationName", "sourceStationId")</strong><small class="muted">@item.Text("sourceStationId")</small></div><span>⟶</span><div><strong>@item.StationName("destinationStationName", "destinationStationId")</strong><small class="muted">@item.Text("destinationStationId")</small></div></div>
        <p>@item.Text("reason")</p><small>Created @item.Time("createdAt")</small>
        @if (item.Text("status") is "PENDING" or "IN_PROGRESS")
        {
            <div class="actions">
                @if (item.Text("status") == "PENDING") { <a class="button secondary" asp-action="Confirm" asp-route-kind="recommendation" asp-route-id="@item.Text("id")" asp-route-status="IN_PROGRESS">Start task</a> }
                <a class="button" asp-action="Confirm" asp-route-kind="recommendation" asp-route-id="@item.Text("id")" asp-route-status="COMPLETED">Mark completed</a>
                <a class="text-link" asp-action="Confirm" asp-route-kind="recommendation" asp-route-id="@item.Text("id")" asp-route-status="DISMISSED">Dismiss</a>
            </div>
        }
    </article>
}
@if (!Model.Any()) { <div class="empty">No tasks match this filter.</div> }
