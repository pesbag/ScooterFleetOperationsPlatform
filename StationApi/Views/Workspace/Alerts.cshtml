@model JsonElement
@{ ViewData["Title"] = "Alerts"; }
<header class="page-header"><div><span class="eyebrow">STAY AHEAD OF DISRUPTION</span><h1>Operational alerts</h1><p>Prioritize the stations that need your attention.</p></div></header>
<form method="get" class="filters"><label>Severity<select name="severity"><option value="">All severities</option>@foreach(var s in new[]{"WARNING","CRITICAL"}) { <option selected="@(ViewBag.Severity == s)">@s</option> }</select></label><label>Status<select name="status"><option value="">All statuses</option>@foreach(var s in new[]{"ACTIVE","RESOLVED"}) { <option selected="@(ViewBag.Status == s)">@s</option> }</select></label><label>Station ID<input name="station" value="@ViewBag.Station" placeholder="e.g. S01" /></label><button>Apply filters</button></form>
@foreach(var alert in Model.EnumerateArray()) { <article class="alert-card"><div class="card-top"><span class="badge @alert.Text("severity").ToLowerInvariant()">@ViewText.Label(alert.Text("severity"))</span><small>@alert.Time("createdAt") · @ViewText.Label(alert.Text("status"))</small></div><h2>@alert.Text("title")</h2><p>@alert.Text("description")</p><div class="actions"><a asp-action="Station" asp-route-id="@alert.Text("stationId")">Station @alert.Text("stationId") ↗</a>@if(alert.Text("status") == "ACTIVE") { <a class="button secondary" asp-action="Confirm" asp-route-kind="alert" asp-route-id="@alert.Text("id")" asp-route-status="RESOLVED">Mark resolved</a> }</div></article> }
@if(Model.GetArrayLength() == 0) { <div class="empty">No alerts match these filters.</div> }
