@model JsonElement
@{ var moves = Model.GetProperty("recommendations").EnumerateArray(); var analysis = Model.GetProperty("analysis"); var station = analysis.GetProperty("station"); ViewData["Title"] = station.Text("name"); var history = station.GetProperty("history").EnumerateArray().OrderBy(x => x.Text("at")).ToList(); }
<a class="back-link" asp-action="Stations">← All stations</a>
<header class="page-header"><div><span class="eyebrow">STATION @station.Text("id")</span><h1>@station.Text("name")</h1><p>Last reported @station.Time("reportedAt")</p></div><span class="badge @analysis.Text("status").ToLowerInvariant()">@ViewText.Label(analysis.Text("status"))</span></header>
<div class="metrics"><article class="metric"><span>Scooters available</span><strong>@station.Text("count")<small> / @station.Text("capacity")</small></strong></article><article class="metric"><span>Utilization</span><strong>@analysis.Text("utilization")%</strong></article><article class="metric"><span>Risk score</span><strong>@analysis.Text("riskScore")<small> / 100</small></strong></article><article class="metric"><span>Net change / hour</span><strong>@analysis.Text("ratePerHour")</strong></article></div>
<div class="notice"><strong>Fleet insight:</strong> @analysis.Text("explanation")</div>
<div class="two-column"><section class="panel padded"><h2>Availability forecast</h2><dl><dt>Estimated time until empty</dt><dd>@analysis.Minutes("shortageMinutes")</dd><dt>Estimated time until full</dt><dd>@analysis.Minutes("fullMinutes")</dd><dt>Available return spaces</dt><dd>@station.Text("availableDocks")</dd><dt>Rentals / returns</dt><dd>@(station.Text("renting") == "True" ? "Open" : "Closed") / @(station.Text("returning") == "True" ? "Open" : "Closed")</dd></dl><p class="muted">Forecasts extend the recent net trend. They are estimates, not guaranteed demand.</p></section>
<section class="panel padded"><h2>Recent availability</h2>
@if (history.Count > 1) {
    var capacity = Math.Max(1, station.Number("capacity"));
    var points = string.Join(" ", history.Select((r, i) => $"{20 + i * 560 / Math.Max(1, history.Count - 1)},{180 - Math.Clamp(r.Number("count"), 0, capacity) * 150 / capacity}"));
    <svg viewBox="0 0 600 210" role="img" aria-label="Scooter availability over the recent observation window"><path d="M20 20V180H580" class="chart-axis"/><polyline points="@points" class="chart-line"/><text x="20" y="205">Earlier</text><text x="540" y="205">Latest</text></svg>
} else { <div class="empty">Waiting for enough history to display a trend.</div> }
<details><summary>View recorded readings</summary><div class="history"><table><thead><tr><th>Recorded at</th><th>Scooters</th></tr></thead><tbody>@foreach(var r in history) { <tr><td>@r.Time("at")</td><td>@r.Text("count")</td></tr> }</tbody></table></div></details>
</section></div>
<section><div class="section-heading"><h2>Station recommendations</h2></div><partial name="_Recommendations" model="moves" /></section>
<section><h2>Active station alerts</h2>@foreach(var alert in Model.GetProperty("alerts").EnumerateArray()) { <article class="alert-card"><strong>@alert.Text("title")</strong><p>@alert.Text("description")</p><a asp-action="Confirm" asp-route-kind="alert" asp-route-id="@alert.Text("id")" asp-route-status="RESOLVED">Mark resolved →</a></article> } @if(Model.GetProperty("alerts").GetArrayLength() == 0) { <p class="muted">No active alerts for this station.</p> }</section>

