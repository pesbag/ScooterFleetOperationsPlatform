@{ ViewData["Title"] = "Sign in"; }
<div class="login-grid">
    <section class="login-story"><a class="brand" href="/"><span class="brand-icon">S</span>SCOOTER FLEET</a><div><span class="eyebrow">FLEET OPERATIONS, SIMPLIFIED</span><h1>Keep your city<br />moving.</h1><p>Understand demand. Anticipate shortages.<br />Put every scooter where it belongs.</p><div class="login-stat"><strong>One workspace.</strong><span>A clearer view of your entire fleet.</span></div></div><small>Monitor · Predict · Rebalance</small></section>
    <section class="login-panel"><div><span class="eyebrow">WELCOME BACK</span><h2>Sign in to your workspace</h2><p class="muted">Use your fleet operations account to continue.</p>
    @if (ViewBag.Error is string error) { <div class="notice danger" role="alert">@error</div> }
    <form asp-action="Login" method="post" class="stack">
        <label>Email address<input type="email" name="email" value="@ViewBag.Email" autocomplete="username" required maxlength="160" placeholder="you@example.com" /></label>
        <label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="128" placeholder="Enter your password" /></label>
        <button type="submit">Sign in →</button>
    </form><p class="muted fine-print">Need access? Contact your fleet administrator.</p></div></section>
</div>
